{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndEligibilityReads",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "freetier:GetAccountPlanState",
        "ecr:GetAuthorizationToken",
        "ecs:ListClusters",
        "ecs:ListTaskDefinitions",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectOnlyExecutionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/creditlens-demo-execution"
    },
    {
      "Sid": "PassOnlyExecutionRoleToTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/creditlens-demo-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OnlyDemoRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchDeleteImage",
        "ecr:PutImageScanningConfiguration",
        "ecr:PutImageTagMutability",
        "ecr:ListTagsForResource",
        "ecr:TagResource",
        "ecr:UntagResource"
      ],
      "Resource": "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/creditlens-demo"
    },
    {
      "Sid": "OnlyDemoCompute",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:DescribeClusters",
        "ecs:UpdateCluster",
        "ecs:UpdateClusterSettings",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DescribeServices",
        "ecs:DeregisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:DeleteTaskDefinitions",
        "ecs:ListTasks",
        "ecs:DescribeTasks",
        "ecs:StopTask",
        "ecs:ListTagsForResource",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:ACCOUNT_ID:cluster/creditlens-demo",
        "arn:aws:ecs:us-east-1:ACCOUNT_ID:service/creditlens-demo/creditlens-demo",
        "arn:aws:ecs:us-east-1:ACCOUNT_ID:task-definition/creditlens-demo:*",
        "arn:aws:ecs:us-east-1:ACCOUNT_ID:task/creditlens-demo/*"
      ]
    },
    {
      "Sid": "OnlyDemoLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:DescribeLogStreams",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsLogGroup",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/ecs/creditlens-demo",
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/ecs/creditlens-demo:*"
      ]
    },
    {
      "Sid": "RegisterOnlySmallDemoTasks",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:us-east-1:ACCOUNT_ID:task-definition/creditlens-demo:*",
      "Condition": {
        "NumericEquals": {
          "ecs:task-cpu": "256",
          "ecs:task-memory": "512"
        },
        "Bool": {
          "ecs:privileged": "false"
        }
      }
    }
  ]
}
