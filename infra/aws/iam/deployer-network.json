{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequiredNetworkReads",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeManagedPrefixLists",
        "ec2:GetManagedPrefixListEntries",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "CreateVpcWithDemoTags",
      "Effect": "Allow",
      "Action": "ec2:CreateVpc",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "CreateSubnetWithDemoTags",
      "Effect": "Allow",
      "Action": "ec2:CreateSubnet",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "CreateInternetGatewayWithDemoTags",
      "Effect": "Allow",
      "Action": "ec2:CreateInternetGateway",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:internet-gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "CreateRouteTableWithDemoTags",
      "Effect": "Allow",
      "Action": "ec2:CreateRouteTable",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroupWithDemoTags",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "UseOwnedParentVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "CreditLens",
          "ec2:ResourceTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroupRulesWithDemoTags",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "ManageOwnedNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSubnet",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteVpc",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "CreditLens",
          "ec2:ResourceTag/Environment": "synthetic-demo"
        }
      }
    },
    {
      "Sid": "TagOnlyDuringOwnedCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CreditLens",
          "aws:RequestTag/Environment": "synthetic-demo",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "AuthorizeSecurityGroupIngress",
            "AuthorizeSecurityGroupEgress"
          ]
        }
      }
    }
  ]
}
