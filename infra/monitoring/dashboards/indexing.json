    {
      "id": 9,
      "title": "Publication visibility drill passed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 20
