{
  "uid": "creditlens-evaluation",
  "title": "CreditLens reviewed evaluation snapshots",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "creditlens",
    "local-evaluation"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Custom RAGAS cited-field support (not packet accuracy)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "creditlens_eval_field_support_ratio",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{job}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
