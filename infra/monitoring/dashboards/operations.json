      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(creditlens_requests_total{job=\"creditlens-synthetic\",status=\"5xx\"}[1m])) or vector(0)) / clamp_min(sum(rate(creditlens_requests_total{job=\"creditlens-synthetic\"}[1m])), 0.000001)",
          "legendFormat": "{{route}}{{status}}{{disposition}}"
