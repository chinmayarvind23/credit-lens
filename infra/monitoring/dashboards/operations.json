    {
      "id": 14,
      "title": "Ingestion jobs by state and parser",
      "type": "timeseries",
      "description": "Current durable SQL gauges. State age is not search-index lag; failed OCR jobs need error diagnosis.",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum by (state, parser) (creditlens_ingestion_jobs)",
          "refId": "A",
          "legendFormat": "{{state}} {{parser}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
