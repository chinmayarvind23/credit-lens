      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (disposition) (creditlens_packets_total{job=\"creditlens-synthetic\"})",
          "legendFormat": "{{route}}{{status}}{{disposition}}"
        }
      ],
      "fieldConfig": {
