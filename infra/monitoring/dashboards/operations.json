{
  "uid": "creditlens-operations",
  "title": "CreditLens | Local synthetic operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "creditlens",
    "synthetic"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "timeseries",
      "description": "Actual synthetic local API metrics. Histogram percentiles are bucket estimates, not benchmark percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"creditlens-synthetic\"}",
          "legendFormat": "{{route}}{{status}}{{disposition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Requests per second",
      "type": "timeseries",
      "description": "Actual synthetic local API metrics. Histogram percentiles are bucket estimates, not benchmark percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(creditlens_requests_total{job=\"creditlens-synthetic\"}[1m]))",
          "legendFormat": "{{route}}{{status}}{{disposition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 by route",
      "type": "timeseries",
      "description": "Actual synthetic local API metrics. Histogram percentiles are bucket estimates, not benchmark percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(creditlens_request_duration_seconds_bucket{job=\"creditlens-synthetic\"}[1m])))",
          "legendFormat": "{{route}}{{status}}{{disposition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP 4xx fraction",
      "type": "timeseries",
      "description": "Actual synthetic local API metrics. Histogram percentiles are bucket estimates, not benchmark percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "creditlens-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(creditlens_requests_total{job=\"creditlens-synthetic\",status=\"4xx\"}[1m])) or vector(0)) / clamp_min(sum(rate(creditlens_requests_total{job=\"creditlens-synthetic\"}[1m])), 0.000001)",
          "legendFormat": "{{route}}{{status}}{{disposition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP 5xx fraction",
