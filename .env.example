# Set these in the process environment, or pass this file to uvicorn --env-file.
# The existing private .env is not automatically read or modified.
CREDITLENS_MODE=demo
CREDITLENS_DATABASE_URL=sqlite:///./data/creditlens.db
# Production requires current server-side grants and Cognito identity configuration.
# CREDITLENS_MODE=production
# CREDITLENS_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
# CREDITLENS_CLIENT_ID=
# CREDITLENS_REQUIRED_SCOPE=creditlens/query

# Optional read-only administrator GraphQL explorer; install the admin extra first.
CREDITLENS_GRAPHQL_ENABLED=false

# Production only: an existing PostgreSQL canonical catalog; never seeded at startup.
# CREDITLENS_CATALOG_BACKEND=postgres
# CREDITLENS_GOVERNED_CATALOG_ID=lender-evidence-v1

# Choose one production search service. Cortex remains the default.
# CREDITLENS_PRODUCTION_SEARCH=cortex
# CREDITLENS_CORTEX_URL=https://ACCOUNT.snowflakecomputing.com/api/v2/databases/DB/schemas/SCHEMA/cortex-search-services/SERVICE:query
# CREDITLENS_CORTEX_TOKEN=

# Persistent Weaviate hybrid search: see docs/weaviate.md before starting the API.
# Remove Cortex settings when selecting Weaviate. Keep RETRIEVAL_MODE at its default.
# CREDITLENS_PRODUCTION_SEARCH=weaviate
# CREDITLENS_WEAVIATE_URL=https://YOUR_WEAVIATE_HOST
# CREDITLENS_WEAVIATE_TOKEN=
# CREDITLENS_WEAVIATE_COLLECTION=CreditLensEvidence
# CREDITLENS_LOCAL_MODEL_DIRECTORY=C:/models/creditlens

# Optional self-hosted service only: infra/weaviate/compose.production.yaml.
# Load separate keys through the secret store, and keep TLS files outside the repo.
# CREDITLENS_WEAVIATE_TLS_DIR=C:/certificates/creditlens
# CREDITLENS_WEAVIATE_ADMIN_KEY=
# CREDITLENS_WEAVIATE_READER_KEY=
# Serving WEAVIATE_TOKEN uses the reader key; the index command uses the admin key.

# Optional shared quota store, separate from retrieval cache configuration.
# Use the same namespace/limit/window across workers; require bounded maxmemory/noeviction.
# CREDITLENS_QUOTA_REDIS_URL=redis://127.0.0.1:16390/15
# CREDITLENS_QUOTA_NAMESPACE=creditlens
# CREDITLENS_QUERY_LIMIT=60
# CREDITLENS_QUERY_WINDOW_SECONDS=60
